{
	"name": "cyber-uni-marketplace-root",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"check:ci": "biome ci",
		"knip": "knip",
		"marketplace:validate": "npx universal-plugin@0.16.0 marketplace validate",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"typecheck": "turbo typecheck",
		"verify": "pnpm check:ci && pnpm knip && pnpm marketplace:validate && turbo build typecheck",
		"web": "pnpm --filter=website"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.14.1",
		"turbo": "^2.9.14",
		"typescript": "^6.0.0"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22"
	}
}
