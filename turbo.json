{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": [
		".claude-plugin/marketplace.json",
		".agents/plugins/marketplace.json",
		".github/plugin/marketplace.json"
	],
	"tasks": {
		"build": {
			"outputs": ["dist/**"],
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
